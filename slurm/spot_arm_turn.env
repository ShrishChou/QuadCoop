# Spot-arm turn in place (docs/spot_arm_pair.md, "Turn in place"): train_coop2.py arguments shared by the three MAPPO
# runs. The 20 kg long object starts at its goal centre; goal heading +-40 deg (clockwise or counter-clockwise,
# equally often); one Spot starts behind the 1 m face, one in front (+-15 deg); success 0.10 m and 6 deg held 1 s;
# 20 s episodes; r7; every actor reads the hand inputs (--hand-obs).
TURN="--pair spot_arm --scratch --partner-map --reward r7 --mean-clip 1.1 --bound-coef 0.01 --entropy-coef 0.003 \
--train-shapes long --train-mass 18,22 --fixed-difficulty --fixed-level 0 \
--pilot-level 0.0,0.0,15,0,10,40,0.10,6,1.0,22,18 --pilot-episode-s 20 --turn-signs --start-opposite --hand-obs"
DEMOS=logs/demos/turn40.pt
# demonstration-assisted run: clone the scripted maneuver (2000 steps), then PPO with an imitation loss fading to 0 by
# iteration 1000; actors start only after 50 critic-only iterations (the cloned actors meet a trained critic)
BC="--bc-data $DEMOS --bc-pretrain-steps 2000 --bc-coef 1.0 --bc-iters 1000 --critic-warmup 50"

# Spot-arm turn pilot: train_coop2.py arguments shared by the wiring check and the four pilot runs
# (docs/spot_arm_pair.md). Level row: 1 m transport, robots spread +-25 deg behind, object within +-10 deg of
# broadside, goal heading change 30 deg (--dyaw-choices: left / straight / right, equally often), success at
# 0.10 m and 6 deg held 1 s, 18-22 kg; 20 s episodes; one elongated object ("long").
PILOT="--pair spot_arm --scratch --partner-map --reward r7 --mean-clip 1.1 --bound-coef 0.01 --entropy-coef 0.003 \
--train-shapes long --train-mass 18,22 --fixed-difficulty --fixed-level 0 \
--pilot-level 1.0,1.0,25,0,10,30,0.10,6,1.0,22,18 --pilot-episode-s 20 --dyaw-choices"

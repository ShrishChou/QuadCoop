# Spot-arm hand wave (docs/spot_arm_pair.md, "Hand-position control"): train_coop2.py arguments for the four MAPPO
# runs. Everything as the turn pilot (slurm/spot_arm_pilot.env: 1 m, long object 18-22 kg, mirrored starts, 20 s,
# 0.10 m / 6 deg held 1 s, r7) plus --hand-obs (every actor reads the hand point and extension, whatever its arm
# mode). TURN30: goal heading change 0 / +-30 deg; TURN60: 0 / +-60 deg (the long box allows up to 81 deg).
source "$(dirname "${BASH_SOURCE[0]}")/spot_arm_pilot.env"
TURN30="$PILOT --hand-obs"
TURN60="${PILOT/1.0,1.0,25,0,10,30,/1.0,1.0,25,0,10,60,} --hand-obs"
